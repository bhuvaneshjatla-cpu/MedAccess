{
  "_type": "Project",
  "_id": "edc53f96-9249-48e9-8806-987824a40091",
  "name": "MedAccess_Sequence_Diagrams",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "8d07a307-b749-4b15-89bb-2113e07f0774",
      "_parent": {
        "$ref": "edc53f96-9249-48e9-8806-987824a40091"
      },
      "name": "MedAccess",
      "documentation": "MedAccess Sequence Diagram Specification -- SD-01 through SD-10.\nMedAccess is a pharmacist-supervised medicine information and availability assistant (medicine search, medicine information, pharmacy availability, indicative price comparison, potential medicine matching, pharmacist verification, pharmacy data updates, incorrect-information reporting, refill reminders, administration and audit logging).\nMedAccess is NOT: an online pharmacy, a diagnostic system, a prescribing system, a medicine-delivery service, an autonomous medicine-substitution system, or a payment/purchasing system.\n\nAuthoritative order: SRS -> Use Cases -> Use Case Specifications -> Activity Diagrams -> Class Diagram -> Sequence Diagrams. These sequence diagrams are a dynamic view of the already-defined MedAccess requirements model and must not introduce new features.",
      "ownedElements": [
        {
          "_type": "UMLCollaboration",
          "_id": "40d4e542-ed8f-4e0e-b93a-12b5cf10aae9",
          "_parent": {
            "$ref": "8d07a307-b749-4b15-89bb-2113e07f0774"
          },
          "name": "SD-01 - Authenticate User",
          "ownedElements": [
            {
              "_type": "UMLInteraction",
              "_id": "67c3e726-eaa5-44be-8652-ba77d8d187d2",
              "_parent": {
                "$ref": "40d4e542-ed8f-4e0e-b93a-12b5cf10aae9"
              },
              "name": "Authenticate User",
              "documentation": "Shows how a user authenticates before accessing restricted functionality. Authentication (who is the user?) is modelled distinctly from authorization (what may the user do?): access is granted only after the account status and authorized role are established, never as an automatic result of authentication alone.\n\nRelated requirements: FR-01, FR-02, FR-03, FR-04, NFR-01, NFR-02, NFR-03",
              "messages": [
                {
                  "_type": "UMLMessage",
                  "_id": "4bbc224c-2d93-4b63-a71f-c08cb11ff9e6",
                  "_parent": {
