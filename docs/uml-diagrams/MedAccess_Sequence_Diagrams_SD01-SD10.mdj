          "name": "SD-06 - Report & Resolve Incorrect Information",
          "ownedElements": [
            {
              "_type": "UMLInteraction",
              "_id": "210e3ca2-765c-49c8-b4e1-3b65a023792f",
              "_parent": {
                "$ref": "9feefec8-4632-48db-bdcd-787d8b065bb6"
              },
              "name": "Report & Resolve Incorrect Information",
              "documentation": "Shows how potentially incorrect price or availability information is reported, reviewed and resolved. A submitted report never automatically changes price/stock data; it only enters an information-quality workflow of authorized review, investigation, resolution and audit recording.\n\nRelated requirements: FR-28-FR-31, FR-38-FR-39",
              "messages": [
                {
                  "_type": "UMLMessage",
                  "_id": "22e2973e-cb0b-4dd3-9cfc-259e49287b0a",
