          "name": "SD-04 - Update Medicine Stock",
          "ownedElements": [
            {
              "_type": "UMLInteraction",
              "_id": "938e2844-d6ba-40d0-8263-f4fc649e64c6",
              "_parent": {
                "$ref": "c71d7536-b75d-46d9-8095-42ce76ecdf54"
              },
              "name": "Update Medicine Stock",
              "documentation": "Shows how authorized pharmacy staff update reported medicine availability (Available / Low Stock / Unavailable). Every update is validated, timestamped, attributed to its author, and recorded as an audit entry; an unauthorized user's update is rejected.\n\nRelated requirements: FR-14, NFR-12, NFR-13, NFR-16, BR-05, FR-38-FR-39",
              "messages": [
                {
                  "_type": "UMLMessage",
                  "_id": "3ef3e64a-5ab8-48b8-884c-474acfe3da25",
                  "_parent": {
                    "$ref": "938e2844-d6ba-40d0-8263-f4fc649e64c6"
                  },
                  "name": "authenticateUser(credentials)",
                  "source": {
                    "$ref": "038f5498-a08d-4d68-9ac1-cbae5862202b"
                  },
                  "target": {
                    "$ref": "20043897-0718-414b-9d70-db5b14297b10"
                  }
                },
