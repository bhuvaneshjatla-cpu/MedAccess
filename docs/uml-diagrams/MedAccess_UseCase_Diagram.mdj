{
  "_type": "Project",
  "_id": "65895a802ddb46769b9ff4323d31646d",
  "name": "MedAccess Use Case Diagram",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "b35cad2692c04586b8f3fee8fe4a177f",
      "_parent": {
        "$ref": "65895a802ddb46769b9ff4323d31646d"
      },
      "name": "MedAccess",
      "documentation": "MedAccess is a pharmacist-supervised medicine information, availability, and affordability assistant. It is not an online pharmacy, diagnostic tool, prescribing system, or autonomous medicine-substitution system.\n\nExplicitly excluded use cases: Diagnose Patient, Prescribe Medicine, Recommend Treatment, Change Dosage, Automatically Substitute Medicine, Purchase Medicine, Make Payment, Deliver Medicine, Manage Controlled Medicines, Dispense Medicine. The MVP also excludes live commercial pharmacy integration, unverified scraping, and advanced AI/OCR.",
      "ownedElements": [
