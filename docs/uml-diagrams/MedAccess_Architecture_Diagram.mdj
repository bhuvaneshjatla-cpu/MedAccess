{
  "_type": "Project",
  "_id": "wS6GLPg7IRRAHeMpmmluc08btbkn",
  "name": "MedAccess Architecture",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "viDH83IdoMYxl3JOULbKsleJJbQP",
      "name": "MedAccess",
      "documentation": "MedAccess System Architecture (ARCH-01). Information and access-support system for medicine search, pharmacy availability, price comparison, matching/verification, reporting, reminders, and administration. Not an online pharmacy; does not diagnose, prescribe, dispense, purchase, or deliver medicines.",
      "ownedElements": [
        {
          "_type": "UMLActor",
          "_id": "9KnEmBOMYYaciwRwWmtMwS6U1Nan",
          "name": "Regular User",
          "visibility": "public"
        },
        {
          "_type": "UMLActor",
          "_id": "21kiWiSt65xSY4X7tzWtkO4cqq3M",
          "name": "Pharmacist / Pharmacy Staff",
          "visibility": "public"
        },
        {
          "_type": "UMLActor",
          "_id": "dGWeI70ngDQsdFRTrCu5vSo5m5ih",
          "name": "Administrator",
          "visibility": "public"
        },
        {
          "_type": "UMLPackage",
          "_id": "pCU73USRlqCvlxtdBqbeu8RPUhkZ",
          "name": "Presentation Layer",
          "visibility": "public",
          "ownedElements": [
            {
              "_type": "UMLComponent",
              "_id": "zVDUQEfIAPvc8ofUQHlTAYvUTYIM",
              "name": "MedAccess Web / UI",
              "visibility": "public",
              "documentation": "User-facing interface. Provides login, search, medicine details, comparison, pharmacy availability, reports, reminders and admin UI. Must not contain authoritative business rules or access the database directly."
            }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "A5OZgs0hd27IBZfKoP31FFErQJLs",
          "name": "Application Layer",
          "visibility": "public",
          "ownedElements": [
            {
              "_type": "UMLComponent",
              "_id": "0wj3YvpAT7re5vRAnXXST7Jgxit4",
              "name": "Authentication & Authorization",
              "visibility": "public",
              "documentation": "Authenticates users, validates credentials, establishes sessions/tokens, determines role, enforces authorization. Related: UC-01, UC-18."
            },
            {
              "_type": "UMLComponent",
              "_id": "wQf2tFpwRt8dU2wRYjpg4vEoNLXd",
              "name": "Medicine Catalogue",
              "visibility": "public",
              "documentation": "Search catalogue, retrieve medicine details, maintain catalogue for admins. Related: UC-02, UC-03, UC-19."
            },
            {
              "_type": "UMLComponent",
              "_id": "uLrSM6T4Air55tV6dfKJJnBXvjYb",
              "name": "Pharmacy Availability",
              "visibility": "public",
              "documentation": "Retrieve/update pharmacy availability, maintain freshness info. Related: UC-04, UC-12."
            },
            {
              "_type": "UMLComponent",
              "_id": "3LRo7fzkjfJvf8GwGKog1RmrUe5E",
              "name": "Price & Comparison",
              "visibility": "public",
              "documentation": "Retrieve indicative prices, support comparison, manage comparison records. Related: UC-05, UC-06, UC-08."
            },
            {
              "_type": "UMLComponent",
              "_id": "oF3XQ1HPdRNLd2cz0NnoTt7zG7MK",
              "name": "Medicine Matching & Verification",
              "visibility": "public",
              "documentation": "Represents potential matches, supports pharmacist verify/reject, stores verification outcomes/comments. Related: UC-07, UC-08, UC-09, UC-10, UC-11."
            },
            {
              "_type": "UMLComponent",
              "_id": "kHlkB9WrMG5mhg8jyO4NZagsJzmQ",
              "name": "Incorrect Information Reporting",
              "visibility": "public",
              "documentation": "Accepts and tracks incorrect-information reports through review/resolution workflow. Related: UC-14, UC-15."
            },
            {
              "_type": "UMLComponent",
              "_id": "3lmV9AbIQ4bH9EX2VML2jCfvHYIR",
              "name": "Refill Reminder",
              "visibility": "public",
              "documentation": "Create/schedule/trigger/manage refill reminders. Related: UC-16, UC-17."
            },
            {
              "_type": "UMLComponent",
              "_id": "xXpEltyYEmctokCp8D0AL3qJe8mM",
              "name": "User & Role Management",
              "visibility": "public",
              "documentation": "Create/manage users, assign roles, activate/deactivate accounts. Related: UC-18."
            },
            {
              "_type": "UMLComponent",
              "_id": "1DXJtOexbia5cWJr7GxWGwnID974",
              "name": "Administrative Reporting",
              "visibility": "public",
              "documentation": "Produces administrative reports and aggregated operational information for admins. Related: UC-20."
            },
            {
              "_type": "UMLComponent",
              "_id": "rOHDdxCpZUsMS15qnidoFeN4mRts",
              "name": "Audit Service",
              "visibility": "public",
              "documentation": "Cross-cutting service recording actor, timestamp, action and result for important traceable actions. Related: UC-21."
            }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "mHNdH9Tn0mr84BT3EId93Pwn1q1A",
          "name": "Data Layer",
          "visibility": "public",
          "ownedElements": [
            {
              "_type": "UMLComponent",
              "_id": "Wc59sNFO6gi9BqZkUTYB1EkDDsTE",
              "name": "MedAccess Database",
              "visibility": "public",
              "documentation": "Persistent storage: users, roles, medicine catalogue, pharmacies, availability, prices, matches, comparisons, verification comments, reports, reminders, audit log entries."
            }
          ]
        },
